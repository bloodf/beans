# Copy to .env (gitignored). Bun loads it for `bun run dev` and `bun run relay`, and the relay
# reads these variables. Keep the key files outside the repo, e.g. ~/.config/beans-relay/.

# Pushes to iPhones: the APNs key from developer.apple.com > Keys (Apple Push Notifications
# service, team scoped, sandbox and production). The 10-character key id is in the file name.
BEANS_RELAY_APNS_TEAM_ID=
BEANS_RELAY_APNS_KEY=/absolute/path/to/AuthKey_XXXXXXXXXX.p8
BEANS_RELAY_APNS_KEY_ID=
# Both commands pass `--apns-topic ai.amoena.beans.dev`: their relay pushes to the development phone build.

# Pushes to Android phones: Firebase console > Project settings > Service accounts > Generate new private key.
#BEANS_RELAY_FCM_SERVICE_ACCOUNT=/absolute/path/to/fcm-service-account.json

# Signs the relay's bearer tokens. Random per boot when unset, which logs every Device out on restart.
#BEANS_RELAY_SECRET=

# Fresh Beans format: isolated homes and ports; existing accounts are not migrated.
#BEANS_HOME=/absolute/path/to/fresh-beans-v2
#BEANS_PORT=4874
# Account routes require Beans-Protocol: 5 and Beans-Format: beans-v2.
# Operator-supplied relay only: no bundled production relay fallback.
#BEANS_RELAY_URL=https://relay.example.com
#BEANS_RELAY_MIN_PROTOCOL=5
