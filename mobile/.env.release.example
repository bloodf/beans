# Public identifiers: use your existing accounts/project. Blank values fail EAS release checks.
BEANS_EXPO_OWNER=
BEANS_EXPO_PROJECT_ID=
BEANS_APPLE_TEAM_ID=
BEANS_ASC_APP_ID=
# Secrets: supply via GitHub/EAS secret stores, never EXPO_PUBLIC_* or committed files.
EXPO_TOKEN=
BEANS_ASC_KEY_P8=
BEANS_ASC_KEY_ID=
BEANS_ASC_ISSUER_ID=
BEANS_PLAY_SERVICE_ACCOUNT_JSON=
# Required for Android prebuild/push: existing Firebase client JSON for this build's app id.
# EAS uses a file environment path; this is not the Play service account.
BEANS_GOOGLE_SERVICES_FILE=
# Local Android core alternative: SDK root plus installed NDK version.
ANDROID_SDK_ROOT=
BEANS_ANDROID_NDK_VERSION=27.1.12297006
# Desktop release inputs; PEM values supplied securely, not written here.
BEANS_UPDATE_PRIVATE_KEY=
BEANS_MAC_CERTIFICATE_P12=
BEANS_MAC_CERTIFICATE_PASSWORD=
BEANS_APPLE_NOTARY_KEY_P8=
BEANS_APPLE_NOTARY_KEY_ID=
BEANS_APPLE_ISSUER_ID=
BEANS_DEFAULT_RELAY_URL=
# Local Mac alternatives.
SIGN_IDENTITY=
NOTARY_PROFILE=
SPARKLE_BIN=
# Legacy local Android signing env file, not EAS remote credentials.
BEANS_ANDROID_ENV=
# Relay push inputs configured by operator, not client builds.
BEANS_RELAY_FCM_SERVICE_ACCOUNT=
BEANS_RELAY_APNS_KEY=
BEANS_RELAY_APNS_KEY_ID=
BEANS_RELAY_APNS_TEAM_ID=
BEANS_RELAY_APNS_TOPIC=ai.amoena.beans
# Preserve existing relay secret; never regenerate as release setup.
BEANS_RELAY_SECRET=
