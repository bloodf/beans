{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote", "requireCommit": true },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "ios": { "simulator": true } },
    "preview": { "distribution": "internal", "autoIncrement": true, "credentialsSource": "remote" },
    "production": { "distribution": "store", "autoIncrement": true, "credentialsSource": "remote", "android": { "buildType": "app-bundle", "ndk": "27.1.12297006" }, "env": { "BEANS_ANDROID_NDK_VERSION": "27.1.12297006" } },
    "github": { "extends": "production", "android": { "buildType": "apk" } },
    "testflight": { "extends": "production" }
  },
  "submit": {
    "production": { "android": { "serviceAccountKeyPath": "./.credentials/play-service-account.json", "track": "internal", "releaseStatus": "completed" }, "ios": { "ascApiKeyPath": "./.credentials/asc.p8" } }
  }
}
