{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "node": "24.22.2",
      "pnpm": "12.18.0"
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "node": "24.22.2",
      "pnpm": "12.18.0"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "credentialsSource": "remote",
      "android": {
        "buildType": "app-bundle",
        "ndk": "27.1.12297006"
      },
      "env": {
        "BEANS_ANDROID_NDK_VERSION": "27.1.12297006"
      },
      "node": "24.22.2",
      "pnpm": "12.18.0"
    },
    "github": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      },
      "node": "24.22.2",
      "pnpm": "12.18.0"
    },
    "testflight": {
      "extends": "production",
      "node": "24.22.2",
      "pnpm": "12.18.0"
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./.credentials/play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      },
      "ios": {
        "ascApiKeyPath": "./.credentials/asc.p8"
      }
    }
  }
}
