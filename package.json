{
  "name": "beans",
  "private": true,
  "version": "1.0.14",
  "workspaces": [
    "web",
    "desktop"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "test:mac-startup": "tsx scripts/test-mac-startup.ts",
    "build": "tsx scripts/build.ts",
    "release-mac": "tsx scripts/release-mac.ts",
    "release-ios": "tsx scripts/release-ios.ts",
    "android:release": "tsx scripts/android-release.ts",
    "desktop": "tsx scripts/desktop.ts",
    "desktop:build": "tsx scripts/desktop.ts build",
    "release-desktop": "tsx scripts/desktop.ts release",
    "cli": "cargo run -q -p beans -- serve",
    "reset": "tsx scripts/reset.ts",
    "relay": "mkdir -p temp && cargo run -q -p beans-relay -- --bind 0.0.0.0:8787 --db temp/beans-relay.db --apns-topic ai.amoena.beans.dev",
    "l10n": "tsx scripts/l10n.ts",
    "check:docs": "tsx scripts/check-docs.ts",
    "check:catalog": "tsx scripts/check-catalog.ts",
    "sync:models": "tsx scripts/sync-models.ts",
    "check:output-baseline": "tsx scripts/check-output-baseline.ts",
    "web": "pnpm --dir web run dev",
    "web:build": "pnpm --dir web run build",
    "web:deploy": "pnpm --dir web run deploy",
    "mobile:dev": "tsx scripts/mobile.ts",
    "mobile:phone": "tsx scripts/mobile.ts --phone",
    "android": "pnpm --dir mobile run core android && pnpm --dir mobile run android",
    "test": "vitest run --config vitest.config.ts",
    "test:scripts": "vitest run --config vitest.config.ts scripts",
    "test:blobatar": "vitest run --config vitest.config.ts packages/beans-blobatar",
    "build:blobatar": "tsx packages/beans-blobatar/build.ts",
    "release-android": "tsx scripts/android-release.ts"
  },
  "devDependencies": {
    "@types/node": "^24",
    "tsx": "4.23.15",
    "vitest": "5.1.0",
    "vite": "^8.0.0",
    "typescript": "^6.0.3",
    "esbuild": "0.28.2",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24.22.2 <25"
  },
  "type": "module"
}
