{
  "relay": {
    "name": "relay",
    "driver": "systemd",
    "service": "beans-relay.service",
    "binary": "/usr/local/bin/beans-relay",
    "health_url": "http://127.0.0.1:8787/v1/health",
    "database": "/var/lib/beans-relay/beans-relay.db",
    "backup_dir": "/var/backups/beans-relay",
    "catalog_dir": "/usr/local/share/beans-relay"
  },
  "runners": [
    {
      "name": "runner-1",
      "driver": "incus",
      "instance": "runner-1",
      "service": "beans.service",
      "binary": "/usr/local/bin/beans",
      "port": 4874,
      "token_file": "/etc/beans/update-token",
      "drain_timeout": 1800
    }
  ]
}
